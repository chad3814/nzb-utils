# Template for the live smoke test. Copy to `smoke.env`, which is gitignored.
#
#   npm run build
#   op run --env-file=smoke.env -- node scripts/smoke.ts path/to/file.nzb
#
# The values below are 1Password secret references, not secrets. `op run`
# resolves them into the child process's environment, so the credential never
# lands in a file, a shell history, or a terminal transcript. Do not replace
# them with literals.

NNTP_HOST=news.example.com
NNTP_PORT=563

# implicit (the 563 convention), starttls, or none. Defaults to implicit.
NNTP_SECURITY=implicit

# Respect the provider's cap. Defaults to 4.
NNTP_CONNECTIONS=4

NNTP_USER=op://Private/Your Provider/username
NNTP_PASS=op://Private/Your Provider/password

# ---------------------------------------------------------------------------
# Optional second provider.
#
# Adds the `-- second provider --` section, which proves the fill-the-gap path
# against a real expired article: an NntpMultiPool asks the primary, takes a
# 430, and fetches the same article from here. Everything below is skipped
# unless NNTP2_HOST is set, because most runs have one account and a second one
# is a real purchase.
#
# NNTP2_USER and NNTP2_PASS are secret references for the same reason the
# primary's are. Uncomment the whole block together; the two credentials are
# required once NNTP2_HOST is present.
# ---------------------------------------------------------------------------

# NNTP2_HOST=news.block-account.example.com
# NNTP2_PORT=563

# implicit (the 563 convention), starttls, or none. Defaults to implicit.
# NNTP2_SECURITY=implicit

# Block accounts are usually capped lower than an unlimited one. Defaults to 4.
# NNTP2_CONNECTIONS=4

# NNTP2_USER=op://Private/Your Block Account/username
# NNTP2_PASS=op://Private/Your Block Account/password
