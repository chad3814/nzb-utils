{
  "name": "@chad3814/nzb-cli",
  "version": "1.1.0",
  "description": "Command-line tool to inspect NZBs and download some or all of their contents",
  "keywords": [
    "nzb",
    "usenet",
    "cli",
    "nntp",
    "yenc"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Chad Walker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chad3814/nzb-utils.git",
    "directory": "packages/nzb-cli"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "node ../../scripts/assert-built.mjs"
  },
  "dependencies": {
    "@chad3814/nntp": "^1.1.0",
    "@chad3814/nzb": "^1.1.0",
    "@chad3814/nzb-parser": "^1.1.0",
    "@chad3814/par2": "^1.1.0",
    "@chad3814/secret-provider": "^1.2.0",
    "@chad3814/yenc": "^1.1.0"
  },
  "bin": {
    "nzb": "dist/bin.js"
  }
}
