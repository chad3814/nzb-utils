{
  "name": "@chad3814/nzb-parser",
  "version": "2.0.0",
  "description": "Strictly-typed parser for NZB 1.1 documents",
  "keywords": [
    "nzb",
    "usenet",
    "nntp",
    "parser"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Chad Walker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chad3814/nzb-utils.git",
    "directory": "packages/nzb-parser"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "node ../../scripts/assert-built.mjs"
  }
}
